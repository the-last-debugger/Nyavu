{
  "manifest_version": 3,
  "name": "Nyavu",
  "version": "0.2.0",
  "description": "Nyavu checks every page you open and warns before a phishing page loads. Press Shusha Nyavu in the toolbar to deploy the net on the current tab.",
  "permissions": [
    "storage",
    "webNavigation",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://nyavu.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nyavu \u2014 Shusha Nyavu"
  },
  "options_page": "options.html",
  "icons": {
    "192": "icon-192.png",
    "512": "icon-512.png"
  }
}